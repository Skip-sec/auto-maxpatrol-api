filter(Host.@Groups.Path like 'Automation / Linux Servers ПО, vulners found for 7 days /%') | select(@Host, host.fqdn, Host.Softs.Name as SoftwareName, Host.Softs.Version as SoftwareVersion, Host.Softs.@Vulners.VulnerableEntity.Path as SoftwarePath, Host.Softs.@Vulners as Vulners, Host.Softs.@Vulners.CVSS3Score, Host.Softs.@Vulners.DiscoveryTime, Host.Softs.@Vulners.Status, Host.Softs.@Vulners.HowToFix, Host.Softs.@Vulners.Id) | filter(Host.softs.@Vulners.Status in ['new', 'inProgress', 'awaitingFix', 'stale', 'overdue'] and Host.Softs.@Vulners.DiscoveryTime >= now() - 100d and host.Softs.@vulners.CVSS3Score >= 7.0  and not (SoftwarePath like "%nord%" and SoftwarePath != null))