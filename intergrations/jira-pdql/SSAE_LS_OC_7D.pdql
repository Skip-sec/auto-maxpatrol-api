filter(Host.@Groups.Path like 'Automation / SSAE Linux, vulners found for 7 days OC /%') | select(@Host, Host.OsName as OsName, Host.OsVersion as OsVersion, Host.@NodeVulners, Host.@NodeVulners.CVSS3Score, Host.@NodeVulners.DiscoveryTime, Host.@NodeVulners.Status, Host.@NodeVulners.HowToFix, Host.@NodeVulners.Id) | filter(Host.@NodeVulners.DiscoveryTime >= now() - 7d and Host.@NodeVulners.Status != 'fixed' and Host.@NodeVulners.Status != 'excluded' and host.@NodeVulners.cvss3score >= 7.0 and OsName not like '%windows%')