filter(Host.@Groups.Path like 'Automation / Windows Server 60 days - discovery OC /%') | select(@Host, host.fqdn, Host.OsName as OsName, host.@NodeVulners.CVEs, Host.@NodeVulners.CVSS3Score, host.@nodevulners.Patch, Host.@NodeVulners.DiscoveryTime, Host.@NodeVulners.Status, Host.@NodeVulners.Id) | filter(Host.@NodeVulners.DiscoveryTime >= now() - 67d and Host.@NodeVulners.DiscoveryTime <= now() - 60d and Host.@NodeVulners.Status != 'fixed' and Host.@NodeVulners.Status != 'excluded' and host.fqdn not in ['SRV-1C-APP.net.billing.ru', 'SRV-1C-CISD.net.billing.ru', 'SRV2-ADM-ISD01.net.billing.ru', 'SRV2-IS2.net.billing.ru', 'SRV-COGNOS.net.billing.ru', 'SRV-DM-ADD.net.billing.ru', 'SRV-DM-MAIN.net.billing.ru', 'SRV-DWH-NXG.net.billing.ru', 'srv-kms2.net.billing.ru', 'SRV-SP-WFE1.net.billing.ru', 'SRV-SQL-COGNOS.net.billing.ru', 'SRV-TM1-APP.net.billing.ru', 'SRV-VBR.net.billing.ru', 'SRV-VBR-REP01.net.billing.ru' ]  and host.fqdn not in [ 'SRV-MNG6.net.billing.ru', 'srv-sp-bi.net.billing.ru', 'SRV-SQL7.net.billing.ru', 'srv-tpltcmadcap.net.billing.ru', 'SRV-ARTIX.net.billing.ru', 'srv-sp-search.net.billing.ru', 'srv-sp-app.net.billing.ru', 'srv-ca3.net.billing.ru', 'srv-tuna01.net.billing.ru', 'srv-hpac-mng.net.billing.ru',  'srv-kms.net.billing.ru', 'srv-wsus01.net.billing.ru', 'srv-sp-office.net.billing.ru' ] and host.fqdn not in [ 'srv-mashup.net.billing.ru', 'srv-auto2.net.billing.ru', 'SRV-CC4.net.billing.ru' ] and host.fqdn not in ['srv-sigur.net.billing.ru', 'srv-auto3.net.billing.ru', 'srv-vpn-admin.net.billing.ru'])