filter(Host.@Groups.Path like 'Automation / Windows Server 7 days - discovery ПО /%') | select(@Host, host.fqdn, Host.Softs.Name as SoftwareName, Host.Softs.Version as SoftwareVersion, Host.Softs.@Vulners.VulnerableEntity.Path as SoftwarePath, Host.Softs.@Vulners as Vulners, Host.Softs.@Vulners.CVSS3Score, Host.Softs.@Vulners.DiscoveryTime, Host.Softs.@Vulners.Status, Host.Softs.@Vulners.HowToFix, Host.Softs.@Vulners.Id) | filter(Host.softs.@Vulners.Status in ['new', 'inProgress', 'awaitingFix', 'stale', 'overdue'] and Host.Softs.@Vulners.DiscoveryTime >= now() - 67d and Host.Softs.@Vulners.DiscoveryTime <= now() - 60d and Host.Softs.@Vulners.CVSS3Score >= 7.0 and host.fqdn not in ['srv-auto2.net.billing.ru','srv-auto3.net.billing.ru'] and softwareName in ['Microsoft Windows Defender', 'microsoft .net framework'])